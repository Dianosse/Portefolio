---
const { content } = Astro.props;

const skills = [
    {
        title: "Languages",
        values: ["Java", "JavaScript", "C", "C++", "SQL", "GDScript"]
    },
    {
        title: "Backend",
        values: ["Node.js", "Express", "Spring Boot", "Fastify"]
    },
    {
        title: "Data",
        values: ["PostgreSQL", "Oracle", "Pentaho", "Apache Hop"]
    },
    {
        title: "Tools",
        values: ["Git", "SVN", "Docker", "Linux"]
    }
];
---

<section id="skills" class="max-w-7xl mx-auto px-8 py-14">

    <h2 class="text-3xl font-bold mb-10">
        {content.title}
    </h2>

    <div class="grid md:grid-cols-2 gap-6">

        {skills.map((group) => (
                <div class="border border-zinc-800 rounded-xl p-6">

                    <h3 class="font-semibold mb-4">
                        {group.title}
                    </h3>

                    <div class="flex flex-wrap gap-2">

                        {group.values.map((skill) => (
                                <span class="bg-zinc-900 border border-zinc-800 text-white px-3 py-1 rounded-full text-sm">
                            {skill}
                        </span>
                        ))}

                    </div>

                </div>
        ))}

    </div>

</section>