---
const { content } = Astro.props;

const skills = [
    {
        title: "Languages",
        values: ["Java", "JavaScript", "C", "C++", "SQL", "GDScript"]
    },
    {
        title: "Backend",
        values: ["Node.js", "Express", "Spring Boot", "Fastify"]
    },
    {
        title: "Data",
        values: ["PostgreSQL", "Oracle", "Pentaho", "Apache Hop"]
    },
    {
        title: "Tools",
        values: ["Git", "SVN", "Docker", "Linux"]
    }
];
---

<section id="skills" class="max-w-7xl mx-auto px-8 py-14">

    <h2 class="text-3xl font-bold mb-10 text-slate-950 dark:text-slate-100">
        {content.title}
    </h2>

    <div class="grid md:grid-cols-2 gap-6">

        {skills.map((group) => (
                <div class="rounded-xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">

                    <h3 class="font-semibold mb-4 text-slate-950 dark:text-slate-100">
                        {group.title}
                    </h3>

                    <div class="flex flex-wrap gap-2">

                        {group.values.map((skill) => (
                                <span
                                        class="rounded-full border border-slate-300 bg-slate-900
                                        px-3 py-1 text-sm text-white
                                        dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200"
                                >
                            {skill}
                        </span>
                        ))}

                    </div>

                </div>
        ))}

    </div>

</section>