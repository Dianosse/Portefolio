---
const { content } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<section id="about" class="max-w-7xl mx-auto px-8 py-14">

    <div class="flex items-center justify-between gap-12">

        <div class="max-w-3xl">
            <h2 class="text-4xl font-bold">
                {content.title}
            </h2>

            <p class="text-slate-600 mt-6 leading-7 whitespace-pre-line">
                {content.text}
            </p>
        </div>

        <img src={`${base}/img_cnam.jpg`} alt="CNAM" class="w-96 h-64 object-cover rounded-2xl"/>

    </div>

</section>