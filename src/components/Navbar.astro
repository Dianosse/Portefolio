---
const { content, lang } = Astro.props;

const base = import.meta.env.BASE_URL;

const otherLang = lang === "fr" ? "en" : "fr";
const currentPath = Astro.url.pathname;

const switchPath = currentPath.replace(
    `/${lang}/`,
    `/${otherLang}/`
);

const cvPath = lang === "fr"
    ? `${base}/CV_ENG.pdf`
    : `${base}/CV_ENG.pdf`;
---

<nav class="fixed top-0 z-50 w-full
            border-b border-slate-200 bg-white/80
            dark:border-slate-800 dark:bg-slate-950/80
            backdrop-blur-xl">

    <div class="mx-auto flex h-24 max-w-screen-2xl items-center justify-between px-10">

        <a href={`${base}/${lang}/`} class="text-xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
            Antoine LIEVRE - Portfolio
        </a>

        <div class="flex items-center gap-6 text-base font-medium">

            <a href={`${base}/${lang}/#about`}
               class="hover:text-indigo-600 dark:hover:text-indigo-400">
                {content.about}
            </a>

            <a href={`${base}/${lang}/#experience`}
               class="hover:text-indigo-600 dark:hover:text-indigo-400">
                {content.experience}
            </a>

            <a href={`${base}/${lang}/#skills`}
               class="hover:text-indigo-600 dark:hover:text-indigo-400">
                {content.skills}
            </a>

            <a href={`${base}/${lang}/projects/`}
               class="hover:text-indigo-600 dark:hover:text-indigo-400">
                {content.projects}
            </a>

            <a href={`${base}/${lang}/#footer`}
               class="hover:text-indigo-600 dark:hover:text-indigo-400">
                {content.contact}
            </a>

            <div class="h-5 w-px bg-slate-200 dark:bg-slate-700"></div>

            <a href="https://github.com/Dianosse" target="_blank"
                    class="rounded-lg border border-slate-300 bg-slate-900 px-4 py-2
                       text-white transition hover:bg-slate-800
                       dark:border-slate-600 dark:bg-slate-100 dark:text-slate-900
                       dark:hover:bg-white"
            >
                GitHub
            </a>

            <a href={cvPath} target="_blank"
                    class="rounded-lg bg-indigo-600 px-4 py-2 text-white transition
                       hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-400"
            >
                CV
            </a>

            <a href={switchPath}
                    class="rounded-lg bg-slate-100 px-3 py-2 transition
                       hover:bg-slate-200
                       dark:bg-slate-800 dark:hover:bg-slate-700"
            >
                {otherLang.toUpperCase()}
            </a>

            <button id="theme-toggle"
                    class="rounded-lg bg-slate-100 p-2 transition hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700"
                    aria-label="Changer le thème"
            >
                <img id="theme-icon" src={`${base}/favicon-moon.svg`} alt="" class="h-6 w-6"
                />
            </button>

        </div>
    </div>
</nav>

<script>
    const button = document.querySelector<HTMLButtonElement>("#theme-toggle");
    const themeIcon = document.querySelector<HTMLImageElement>("#theme-icon");

    function updateFavicon(isDark: boolean) {
        const root = document.documentElement;
        const base = root.dataset.base ?? "/";

        const oldFavicon = document.querySelector("#favicon");

        const newFavicon = document.createElement("link");

        newFavicon.id = "favicon";
        newFavicon.rel = "icon";
        newFavicon.type = "image/svg+xml";

        newFavicon.href = `${base}${
            isDark
                ? "/favicon-moon.svg"
                : "/favicon-sun.svg"
        }?v=${Date.now()}`;

        oldFavicon?.remove();
        document.head.appendChild(newFavicon);
    }

    function updateThemeIcon() {
        if (!themeIcon) return;

        const root = document.documentElement;
        const base = root.dataset.base ?? "/";

        const isDark = root.classList.contains("dark");

        themeIcon.src = `${base}${
            isDark
                ? "/favicon-sun.svg"
                : "/favicon-moon.svg"
        }`;
    }

    updateThemeIcon();

    button?.addEventListener("click", () => {
        const root = document.documentElement;

        const isDark = !root.classList.contains("dark");

        root.classList.toggle("dark", isDark);

        localStorage.setItem(
            "theme",
            isDark ? "dark" : "light"
        );

        updateFavicon(isDark);
        updateThemeIcon();
    });
</script>