---
const { content } = Astro.props;
---

<section id="experience" class="mx-auto max-w-7xl px-8 py-14">

    <div class="mb-3 h-1 w-10 rounded-full bg-indigo-600 dark:bg-indigo-400"></div>

    <h2 class="mb-8 text-3xl font-bold tracking-tight text-slate-950 dark:text-slate-100">
        {content.title}
    </h2>

    <div class="grid gap-4">

        {content.items.map((item: {
            date: string;
            title: string;
            place: string;
            alternance?: boolean;
        }) => (
                <div
                        class="flex items-center justify-between rounded-2xl
                       border border-slate-200 bg-white p-6 transition
                       hover:border-indigo-200 hover:shadow-md
                       dark:border-slate-800 dark:bg-slate-900
                       dark:hover:border-indigo-500/50"
                >

                    <div>
                    <span class="text-sm font-medium text-indigo-600 dark:text-indigo-400">
                        {item.date}
                    </span>

                        <h3 class="mt-2 text-xl font-semibold text-slate-950 dark:text-slate-100">
                            {item.title}
                        </h3>

                        <p class="mt-1 text-slate-500 dark:text-slate-400">
                            {item.place}
                        </p>
                    </div>

                    {item.alternance && (
                            <span class="rounded-full bg-indigo-50 px-4 py-2 text-sm font-medium text-indigo-700 dark:bg-indigo-500/15 dark:text-indigo-300">
                                Alternance - ProCapital
                            </span>
                    )}

                </div>
        ))}

    </div>

</section>