---
import Layout from "../../../layouts/Layout.astro";
import { projects } from "../../../data/projects";

const base = import.meta.env.BASE_URL;

export function getStaticPaths() {
    return projects.map((project) => ({
        params: {
            slug: project.slug
        },

        props: {
            project
        }
    }));
}

const { project } = Astro.props;

const content = project.fr;

const imagePath = `${base}/${project.image.replace(/^\//, "")}`;
---

<Layout title={`${project.name} — Antoine`} lang="fr">

    <main class="max-w-4xl mx-auto px-6 py-24">

        <a href={`${base}/fr/projects/`} class="text-zinc-500 hover:underline dark:text-zinc-400 dark:hover:text-zinc-200">
            ← Retour
        </a>

        <img src={imagePath} alt={project.name} class="mt-4 mb-5 w-full rounded-xl border border-slate-200 dark:border-slate-800"/>

        <h1 class="text-5xl font-bold mt-8 text-slate-950 dark:text-slate-100">
            {project.name}
        </h1>

        <div class="flex gap-2 mt-6">

            {project.stack.map((tech) => (
                    <span
                            class="rounded border border-zinc-300 px-3 py-1
                           text-slate-700
                           dark:border-zinc-700 dark:text-slate-300"
                    >
                    {tech}
                </span>
            ))}

        </div>

        <p class="text-slate-600 text-lg leading-8 mt-10 whitespace-pre-line dark:text-slate-400">
            {content.description}
        </p>

        <a href={project.github} target="_blank"
                class="inline-block mt-10 rounded-lg
                   border border-zinc-300 px-5 py-3
                   text-slate-900 transition hover:bg-slate-100
                   dark:border-zinc-700 dark:text-slate-100
                   dark:hover:bg-slate-800"
        >
            Lien GitHub du projet
        </a>

    </main>

</Layout>