---
import "../styles/global.css";

const {
    title = "Portfolio",
    description = "Portfolio",
    lang = "fr"
} = Astro.props;
---

<html lang={lang}>
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>
    <meta name="description" content={description} />
</head>

<body>
<slot />
</body>
</html>